# Stock Caddy: no custom modules needed.
# Merge these handlers into your EXISTING authenticated OpenCode site.
# No environment variables required. Edit the site, password hash, token-file path, and upstream addresses.
# The private token file must contain the same value used by Bun, without a trailing newline.
# Use your existing authentication instead of basic_auth where appropriate;
# authentication MUST cover /voice/* as well as the OpenCode routes.
opencode.example.com {
	basic_auth {
		opencode REPLACE_WITH_BCRYPT_HASH
	}

	# Replace OpenCode's Workbox service worker with this repository's no-op
	# worker. The stock worker serves its cached app shell for every in-scope
	# navigation and its denylist does not cover /voice, so it would hide both
	# the injected microphone and the settings page. Adjust the root to your
	# checkout.
	handle /sw.js {
		root * /path/to/opencode-webui-voice-input/server
		header Cache-Control "no-cache"
		file_server
	}

	handle /voice {
		redir * /voice/ 308
	}
	handle /voice/* {
		reverse_proxy 127.0.0.1:4097 {
			# Overwrite, never append or trust a client-supplied value.
			header_up X-OCVD-Proxy-Token {file./path/to/opencode-voice/proxy.token}
		}
	}

	@documents {
		method GET HEAD
		header Accept *text/html*
		not header Upgrade *
		not path /api/* /event /global/event
	}
	handle @documents {
		# Bun fetches only the HTML shell from OpenCode and injects voice.js.
		reverse_proxy 127.0.0.1:4097 {
			header_up X-OCVD-Proxy-Token {file./path/to/opencode-voice/proxy.token}
		}
	}
	handle {
		# Streaming API, WebSocket, assets and uploads do NOT pass through Bun.
		reverse_proxy 127.0.0.1:4096
	}
}
