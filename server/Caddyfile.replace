# OPTIONAL: injection directly inside Caddy. Requires this nonstandard module:
#   xcaddy build --with github.com/caddyserver/replace-response
# The supplied stock Caddyfile is the preferred option when avoiding custom builds.
# Root deployment JSON: "basePath": "/", "proxyMode": "preserve".
# Requires the exact lowercase <head> opening tag. Prefer Bun's parser-based
# injector for other HTML shapes or any meta CSP. This literal replacement is
# supported only with HTTP-header CSP (no meta CSP), which constrains the bootstrap. The script must be first and parser-blocking.
# For nested apps update all route matchers, script src and data-base-path;
# follow README.md's preserve/strip contract. Do not expose root aliases.
# Bun serves /voice/sw.js with Service-Worker-Allowed: /; no sibling /sw.js handler.
opencode.example.com {
	basic_auth {
		opencode REPLACE_WITH_BCRYPT_HASH
	}
	handle /voice {
		redir /voice/ 308
	}
	handle /voice/* {
		reverse_proxy 127.0.0.1:4097 {
			header_up X-OCVD-Proxy-Token {file./path/to/opencode-voice/proxy.token}
		}
	}
	@documents {
		method GET
		header Accept *text/html*
		not header Upgrade *
		not path /api/* /event /global/event
	}
	handle @documents {
		route {
			replace {
				match {
					status 200
					header Content-Type text/html*
				}
				"<head>" "<head><script id=\"ocvd-server-script\" src=\"/voice/voice.js\" data-base-path=\"/\"></script>"
			}
			reverse_proxy 127.0.0.1:4096 {
				header_up Accept-Encoding identity
				header_up -If-None-Match
				header_up -If-Modified-Since
				header_up -Range
				header_up -If-Range
				header_down -ETag
				header_down -Last-Modified
				header_down -Content-MD5
				header_down -Digest
				header_down -Content-Digest
				header_down -Accept-Ranges
				header_down Cache-Control no-store
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:4096
	}
}
