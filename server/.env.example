# All variables are read by Bun; no Node runtime or npm install is required.
VOICE_PUBLIC_ORIGIN=https://opencode.example.com
VOICE_PORT=4097
# Bind address. Defaults to loopback; set 0.0.0.0 when a containerized proxy reaches the host.
VOICE_HOST=127.0.0.1
OPENCODE_UPSTREAM=http://127.0.0.1:4096
# Keys are added in the authenticated /voice/ settings page.
VOICE_ENCRYPTION_KEY_FILE=/home/pi/.config/opencode-voice/encryption.key
# Optional legacy fallback until the first provider save:
# GROQ_API_KEY_FILE=/home/pi/.config/opencode-voice/groq.key
VOICE_DB_PATH=/home/pi/.local/state/opencode-voice/settings.sqlite
# Caddy must overwrite X-OCVD-Proxy-Token with the SAME random value.
# Generate with: openssl rand -hex 32
VOICE_PROXY_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
# Alternative for Bun only (Caddy still needs the raw value in its environment):
# VOICE_PROXY_TOKEN_FILE=/home/pi/.config/opencode-voice/proxy.token
# Legacy fallback endpoint only (new configuration is saved through /voice/):
# VOICE_STT_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions
VOICE_MAX_AUDIO_MB=20
VOICE_MAX_RECORDING_SECONDS=300
VOICE_TIMEOUT_SECONDS=60
VOICE_MAX_CONCURRENT=2
VOICE_REQUESTS_PER_MINUTE=10
